# Copy to .env and adjust. npm start and npm run dev load .env when it exists,
# using Node's built-in --env-file-if-exists, so no dotenv package is needed.
# Real environment variables take precedence over values in this file.

# Secret for signing login tokens. Required when NODE_ENV=production;
# otherwise a random one is made each run and sign-ins end on restart.
# APP_SECRET=change-me-to-a-long-random-string
# NODE_ENV=production

# MongoDB connection string.
MONGOLAB_URI=mongodb://127.0.0.1/glazecalc_app_dev

# Port for npm start, which serves the app and its API (under /api) together.
# npm run dev ignores this: the dev server uses 3000 and the API 4000 (API_PORT).
PORT=3000
