{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "glazecalc": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "client",
      "prefix": "gc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "client/main.ts",
            "index": "client/index.html",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "client/public"
              },
              // The advice page's translations, made from client/public/i18n/records at each build
              // (scripts/advice-i18n.mjs).
              {
                "glob": "**/*",
                "input": "dist/i18n-generated",
                "output": "i18n"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@fontsource-variable/lora/wght.css",
              "node_modules/@fontsource-variable/lora/wght-italic.css",
              "client/styles.scss"
            ],
            "loader": {
              ".md": "text",
              // The standard advice (data/advice.ndjson), drawn into the advice page at build time.
              ".ndjson": "text"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  // 650 kB before hydration (docs/seo-plan.md), which adds about 32 kB, and
                  // about 10 kB for the Asian font stacks and script rules.
                  "type": "initial",
                  "maximumWarning": "710kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "subresourceIntegrity": true,
              "security": {
                "autoCsp": true
              },
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "prerender": {
              "outputPath": "dist/prerender",
              "server": "client/main.server.ts",
              "prerender": false,
              "ssr": {
                "entry": "client/server-entry.ts"
              },
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 3000,
            "proxyConfig": "client/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "glazecalc:build:production"
            },
            "development": {
              "buildTarget": "glazecalc:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  }
}
