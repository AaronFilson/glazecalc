{
  // The core on its own, as the library repo will check it (step 4): strict erasable TypeScript, ES modules,
  // nothing but itself (no DOM or Node types; globals.d.ts declares structuredClone). A host type-checks the
  // core's source with its own flags, so the core takes the strictest a host uses: Angular's
  // noPropertyAccessFromIndexSignature, and noUnusedLocals and noUnusedParameters. npm run typecheck runs it.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["**/*.ts"],
  "exclude": ["test/**"]
}
