{
  // The catalog on its own, as its library repo will check it: strict erasable TypeScript, ES modules, nothing
  // but itself and the core (no DOM or Node types). It takes the same flags as the core, the strictest a host
  // type-checks imported source with. npm run typecheck runs it.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["**/*.ts", "../core/globals.d.ts"],
  "exclude": ["test/**"]
}
