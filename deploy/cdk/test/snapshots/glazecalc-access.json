{
  "Description": "glazecalc: GitHub's OIDC provider, the deploy roles and their SSM documents, the operator policy",
  "Resources": {
    "GitHubOidcA2A496A3": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Url": "https://token.actions.githubusercontent.com"
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate",
      "Metadata": {
        "aws:cdk:path": "glazecalc-access/GitHubOidc/Resource"
      }
    },
    "DeployRole885297C3": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:AaronFilson/glazecalc:environment:production"
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcA2A496A3"
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:SendCommand",
                  "Condition": {
                    "StringEquals": {
                      "ssm:resourceTag/app": "glazecalc"
                    }
                  },
                  "Effect": "Allow",
                  "Resource": "arn:aws:ec2:us-west-2:724654236968:instance/*",
                  "Sid": "RunOnTaggedInstanceOnly"
                },
                {
                  "Action": "ssm:SendCommand",
                  "Effect": "Allow",
                  "Resource": "arn:aws:ssm:us-west-2:724654236968:document/glazecalc-deploy",
                  "Sid": "OnlyTheDeployDocument"
                },
                {
                  "Action": [
                    "ssm:ListCommands",
                    "ssm:ListCommandInvocations",
                    "ssm:GetCommandInvocation"
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "ReadCommandResults"
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "ssm-deploy"
          }
        ],
        "RoleName": "glazecalc-github-deploy",
        "Tags": [
          {
            "Key": "app",
            "Value": "glazecalc"
          }
        ]
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate",
      "Metadata": {
        "aws:cdk:path": "glazecalc-access/DeployRole/Resource"
      }
    },
    "DeployDocument": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "Content": {
          "schemaVersion": "2.2",
          "description": "Deploys a glazecalc image tag on this instance with /opt/glazecalc/deploy.sh. The only command the GitHub deploy role may run.",
          "parameters": {
            "tag": {
              "type": "String",
              "description": "latest, or sha-<full commit SHA>",
              "allowedPattern": "^(latest|sha-[0-9a-f]{40})$"
            }
          },
          "mainSteps": [
            {
              "action": "aws:runShellScript",
              "name": "deploy",
              "inputs": {
                "timeoutSeconds": "900",
                "runCommand": [
                  "/opt/glazecalc/deploy.sh '{{ tag }}'"
                ]
              }
            }
          ]
        },
        "DocumentFormat": "JSON",
        "DocumentType": "Command",
        "Name": "glazecalc-deploy",
        "Tags": [
          {
            "Key": "app",
            "Value": "glazecalc"
          }
        ],
        "UpdateMethod": "NewVersion"
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate",
      "Metadata": {
        "aws:cdk:path": "glazecalc-access/DeployDocument"
      }
    },
    "StagingRoleE04E1AF6": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:AaronFilson/glazecalc:environment:staging"
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcA2A496A3"
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "ssm:SendCommand",
                  "Condition": {
                    "StringEquals": {
                      "ssm:resourceTag/app": "glazecalc"
                    }
                  },
                  "Effect": "Allow",
                  "Resource": "arn:aws:ec2:us-west-2:724654236968:instance/*",
                  "Sid": "RunOnTaggedInstanceOnly"
                },
                {
                  "Action": "ssm:SendCommand",
                  "Effect": "Allow",
                  "Resource": "arn:aws:ssm:us-west-2:724654236968:document/glazecalc-staging-deploy",
                  "Sid": "OnlyTheStagingDocument"
                },
                {
                  "Action": [
                    "ssm:ListCommands",
                    "ssm:ListCommandInvocations",
                    "ssm:GetCommandInvocation"
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "ReadCommandResults"
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "ssm-staging-deploy"
          }
        ],
        "RoleName": "glazecalc-github-staging",
        "Tags": [
          {
            "Key": "app",
            "Value": "glazecalc"
          }
        ]
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate",
      "Metadata": {
        "aws:cdk:path": "glazecalc-access/StagingRole/Resource"
      }
    },
    "StagingDocument": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "Content": {
          "schemaVersion": "2.2",
          "description": "Deploys a glazecalc staging image on this instance with /opt/glazecalc/staging.sh. The only command the GitHub staging role may run.",
          "parameters": {
            "tag": {
              "type": "String",
              "description": "staging-<full commit SHA>, or sha-<full commit SHA> (a master build)",
              "allowedPattern": "^(staging|sha)-[0-9a-f]{40}$"
            }
          },
          "mainSteps": [
            {
              "action": "aws:runShellScript",
              "name": "stage",
              "inputs": {
                "timeoutSeconds": "900",
                "runCommand": [
                  "/opt/glazecalc/staging.sh '{{ tag }}'"
                ]
              }
            }
          ]
        },
        "DocumentFormat": "JSON",
        "DocumentType": "Command",
        "Name": "glazecalc-staging-deploy",
        "Tags": [
          {
            "Key": "app",
            "Value": "glazecalc"
          }
        ],
        "UpdateMethod": "NewVersion"
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "RetainExceptOnCreate",
      "Metadata": {
        "aws:cdk:path": "glazecalc-access/StagingDocument"
      }
    },
    "OperatorPolicy63C1EB6F": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "",
        "ManagedPolicyName": "glazecalc-operator",
        "Path": "/",
        "PolicyDocument": {
          "Statement": [
