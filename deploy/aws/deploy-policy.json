{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnTaggedInstanceOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-west-2:724654236968:instance/*",
      "Condition": {
        "StringEquals": { "ssm:resourceTag/app": "glazecalc" }
      }
    },
    {
      "Sid": "OnlyTheDeployDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-west-2:724654236968:document/glazecalc-deploy"
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": ["ssm:ListCommands", "ssm:ListCommandInvocations", "ssm:GetCommandInvocation"],
      "Resource": "*"
    }
  ]
}
