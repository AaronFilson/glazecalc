{
  "schemaVersion": "2.2",
  "description": "Deploys a glazecalc image tag on this instance with /opt/glazecalc/deploy.sh. The only command the GitHub deploy role may run.",
  "parameters": {
    "tag": {
      "type": "String",
      "description": "latest, or sha-<full commit SHA>",
      "allowedPattern": "^(latest|sha-[0-9a-f]{40})$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deploy",
      "inputs": {
        "timeoutSeconds": "600",
        "runCommand": ["/opt/glazecalc/deploy.sh '{{ tag }}'"]
      }
    }
  ]
}
