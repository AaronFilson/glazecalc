{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReceivedMail",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::glazecalc-mail-724654236968/inbound/*"
    },
    {
      "Sid": "SendOnlyAsTheForwarder",
      "Effect": "Allow",
      "Action": "ses:SendRawEmail",
      "Resource": "arn:aws:ses:us-west-2:724654236968:identity/*",
      "Condition": { "StringEquals": { "ses:FromAddress": "forwarder@glazecalcapp.com" } }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-west-2:724654236968:log-group:/aws/lambda/glazecalc-mail-forwarder:*"
    }
  ]
}
