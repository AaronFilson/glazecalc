# nginx's logs (access and error), kept 14 days and then deleted. Installed as
# /etc/logrotate.d/nginx by setup-instance.sh and enable-https.sh, replacing the
# package's weekly rotation of 14 files (about three months). logrotate runs
# daily from logrotate.timer.
/var/log/nginx/*.log {
    daily
    rotate 14
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        # Reopen the log files (nginx writes to the renamed ones until told).
        [ ! -f /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
