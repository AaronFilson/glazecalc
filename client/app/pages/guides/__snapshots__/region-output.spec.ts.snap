// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`region blocks before Korea > says exactly what it said before for Türkiye: food 1`] = `"<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Türkiye"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Türkiye (checked October 14, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=16076&amp;MevzuatTur=9&amp;MevzuatTertip=5">Türk Gıda Kodeksi Gıda ile Temas Eden Seramik Malzemeler Tebliği (Tebliğ No: 2012/30)</a>.</gc-rich> At least three samples are tested: the ware passes if their average is within the limit and no single sample is more than 50% over it. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=16076&amp;MevzuatTur=9&amp;MevzuatTertip=5">mevzuat.gov.tr</a>.</p></gc-source-links>"`;

exports[`region blocks before Korea > says exactly what it said before for Türkiye: poison 1`] = `"<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Türkiye"><table class="guide-table"><caption> Who to call in Türkiye (numbers checked October 14, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>One number for ambulance, fire, police, gendarmerie and coast guard.</td></tr><tr><th scope="row"> Poison advice: National Poison Information Centre (Ulusal Zehir Danışma Merkezi, UZEM) </th><td class="num"><a dir="ltr" class="phone" href="tel:114">114</a></td><td> 24 hours, every day </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.112.gov.tr/hakkimizda">112.gov.tr</a>, <a href="https://divrigisadikozgurdh.saglik.gov.tr/TR-389626/alo-114.html">divrigisadikozgurdh.saglik.gov.tr</a>.</p></gc-source-links></div>"`;

exports[`region blocks before Korea > says exactly what it said before for Türkiye: shops 1`] = `"<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Türkiye"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Türkiye (checked October 14, 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://www.pegaseramik.com.tr/urunler/hammaddeler-ve-oksitler-10">Pega Seramik</a><br><span translate="no" class="muted">Tuzla (İstanbul)</span></th><td data-label="Sells">raw glaze materials and oxides</td><td data-label="Packs seen">250 g, 500 g, and 1 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">SODYUM FELDSPAT; POTASYUM FELDSPAT; KAOLEN; KUVARS; KOLEMANİT</span></td></tr><tr><th scope="row"><a translate="no" href="https://www.tecnodiecishopping.com/urunler/ham-maddeler">Tecnodieci Shopping</a><br><span translate="no" class="muted">Bozüyük (Bilecik)</span></th><td data-label="Sells">raw glaze materials and frits</td><td data-label="Packs seen"></td><td data-label="Materials seen, by the shop's names"><span translate="no">Sodyum Feldspat(Albit); Kolemanit; Üleksit; Nefelin; Opak Beyaz Seramik Frit 1040-1060 C</span></td></tr><tr><th scope="row"><a translate="no" href="https://seramiksir.com/hammaddeler">Seramiksir</a></th><td data-label="Sells">raw glaze materials and frits</td><td data-label="Packs seen">100 g, 500 g, and 1 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Nefelin Siyenit; Zirkonyum Silikat; Wollastonite; Talk; Titan Rutil</span></td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.pegaseramik.com.tr/urunler/hammaddeler-ve-oksitler-10">pegaseramik.com.tr</a>, <a href="https://www.tecnodiecishopping.com/urunler/ham-maddeler">tecnodiecishopping.com</a>, <a href="https://seramiksir.com/hammaddeler">seramiksir.com</a>.</p></gc-source-links>"`;

exports[`region blocks before Korea > says exactly what it said before for Türkiye: silica 1`] = `"<div tabindex="0" role="region" class="guide-table-scroll" aria-label="The silica limit in Türkiye"><table class="guide-table"><caption> The workplace limit for respirable crystalline silica in Türkiye, an 8-hour average (checked October 14, 2026) </caption><tbody><tr><th scope="row">Limit for respirable quartz, where Q is the silica (SiO₂) in the dust, in %</th><td class="num"> 10 / (Q + 2) mg/m³ </td></tr><tr><th scope="row">Quartz, for dust that is all quartz</th><td class="num">0.098 mg/m³</td></tr><tr><th scope="row">Cristobalite, for dust that is all cristobalite</th><td class="num">0.049 mg/m³</td></tr></tbody></table></div><p> A binding limit. <gc-rich>Set by <a href="https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=18989&amp;MevzuatTur=7&amp;MevzuatTertip=5">Tozla Mücadele Yönetmeliği (RG 05.11.2013/28812), Ek-1</a>.</gc-rich> Türkiye has not adopted the EU's binding limit (Directive (EU) 2017/2398). Tridymite has the same limit as cristobalite: half the value for quartz. </p><p><gc-rich>Dust masks here are sold by class: FFP2 for glaze dust, or FFP3 for more protection (<a href="https://www.resmigazete.gov.tr/eskiler/2019/05/20190501-5.htm">the official classes</a>).</gc-rich> Türkiye's rules for protective equipment follow the EU's (Regulation (EU) 2016/425). </p><p><gc-rich>The national body for safety at work: <a href="https://csgb.gov.tr/">Çalışma ve Sosyal Güvenlik Bakanlığı, İş Sağlığı ve Güvenliği Genel Müdürlüğü (ÇSGB İSGGM)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.mevzuat.gov.tr/mevzuat?MevzuatNo=18989&amp;MevzuatTur=7&amp;MevzuatTertip=5">mevzuat.gov.tr</a>, <a href="https://www.resmigazete.gov.tr/eskiler/2019/05/20190501-5.htm">resmigazete.gov.tr</a>, <a href="https://csgb.gov.tr/">csgb.gov.tr</a>.</p></gc-source-links>"`;

exports[`region blocks before Turkey > says exactly what it said before for every earlier region: food 1`] = `
{
  "AT": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Austria"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Austria (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&amp;Gesetzesnummer=10010737">Keramik-Verordnung (BGBl. Nr. 893/1993)</a>.</gc-rich> Austria also limits zinc, antimony and barium. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&amp;Gesetzesnummer=10010737">ris.bka.gv.at</a>.</p></gc-source-links>",
  "AU": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Australia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Australia (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Cups, mugs, jugs, bowls, teapots and other tableware under 1100 mL </th><td class="num">7&nbsp;mg/L</td><td class="num">0.7&nbsp;mg/L</td></tr><tr><th scope="row"> The same, 1100 mL or more </th><td class="num">2&nbsp;mg/L</td><td class="num">0.2&nbsp;mg/L</td></tr><tr><th scope="row"> Plates, saucers and similar tableware </th><td class="num">20&nbsp;mg/L</td><td class="num">2&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware </th><td class="num">7&nbsp;mg/L</td><td class="num">0.7&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.legislation.gov.au/F1996B03651/2026-07-13/2026-07-13/text/original/epub/OEBPS/document_1/document_1.html">Customs (Prohibited Imports) Regulations 1956, regulation 4E</a>.</gc-rich> These limits are for imported ware; we found no official limit for ware made in Australia. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.legislation.gov.au/F1996B03651/2026-07-13/2026-07-13/text/original/epub/OEBPS/document_1/document_1.html">legislation.gov.au</a>.</p></gc-source-links>",
  "BE": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Belgium"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Belgium (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">6&nbsp;µg/dm²</td><td class="num">4&nbsp;µg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">30&nbsp;µg/L</td><td class="num">20&nbsp;µg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">10&nbsp;µg/L</td><td class="num">7&nbsp;µg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.ejustice.just.fgov.be/cgi/article_body.pl?language=fr&amp;caller=summary&amp;pub_date=2026-09-11&amp;numac=2026006323">Koninklijk besluit van 19 juli 2026 / Arrêté royal du 19 juillet 2026</a>.</gc-rich> In force from 29 May 2026. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.ejustice.just.fgov.be/cgi/article_body.pl?language=fr&amp;caller=summary&amp;pub_date=2026-09-11&amp;numac=2026006323">ejustice.just.fgov.be</a>.</p></gc-source-links>",
  "BG": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Bulgaria"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Bulgaria (checked October 8, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "CY": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Cyprus"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Cyprus (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "CZ": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Czechia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Czechia (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr><tr><th scope="row"> The rim of a piece for drinking from: a 20 mm band outside the top edge, per piece </th><td class="num">2&nbsp;mg</td><td class="num">0,2&nbsp;mg</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://e-sbirka.gov.cz/sb/2001/38?zalozka=text">Vyhláška č. 38/2001 Sb.</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://e-sbirka.gov.cz/sb/2001/38?zalozka=text">e-sbirka.gov.cz</a>.</p></gc-source-links>",
  "DE": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Germany"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Germany (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.gesetze-im-internet.de/bedggstv/BJNR008660992.html">Bedarfsgegenständeverordnung (BedGgstV), Anlage 6</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.gesetze-im-internet.de/bedggstv/BJNR008660992.html">gesetze-im-internet.de</a>.</p></gc-source-links>",
  "DK": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Denmark"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Denmark (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> The rim of a piece for drinking from: a 2 cm band, inside and out </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.retsinformation.dk/eli/lta/2020/681">Bekendtgørelse nr. 681 af 25. maj 2020</a>.</gc-rich> A cup or mug must meet both the limit for its rim and the limit for pieces that can be filled. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.retsinformation.dk/eli/lta/2020/681">retsinformation.dk</a>.</p></gc-source-links>",
  "EE": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Estonia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Estonia (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "ES": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Spain"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Spain (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2006-13274">Real Decreto 891/2006</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.boe.es/buscar/act.php?id=BOE-A-2006-13274">boe.es</a>.</p></gc-source-links>",
  "FI": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Finland"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Finland (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.finlex.fi/fi/lainsaadanto/saadoskokoelma/2006/165">Asetus 165/2006</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.finlex.fi/fi/lainsaadanto/saadoskokoelma/2006/165">finlex.fi</a>.</p></gc-source-links>",
  "FR": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in France"><table class="guide-table"><caption> What a fired piece may release in the legal test, in France (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.legifrance.gouv.fr/loda/id/JORFTEXT000000874106/">Arrêté du 7 novembre 1985</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.legifrance.gouv.fr/loda/id/JORFTEXT000000874106/">legifrance.gouv.fr</a>.</p></gc-source-links>",
  "GB": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in United Kingdom"><table class="guide-table"><caption> What a fired piece may release in the legal test, in United Kingdom (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.legislation.gov.uk/uksi/2012/2619">The Materials and Articles in Contact with Food Regulations 2012 (England, Wales, Scotland, Northern Ireland)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.legislation.gov.uk/uksi/2012/2619">legislation.gov.uk</a>.</p></gc-source-links>",
  "GR": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Greece"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Greece (checked October 8, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "HR": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Croatia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Croatia (checked October 8, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "HU": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Hungary"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Hungary (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "IE": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Ireland"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Ireland (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.irishstatutebook.ie/eli/2017/si/49/made/en/print">S.I. No. 49 of 2017</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.irishstatutebook.ie/eli/2017/si/49/made/en/print">irishstatutebook.ie</a>.</p></gc-source-links>",
  "IT": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Italy"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Italy (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.gazzettaufficiale.it/eli/gu/1985/04/26/98/sg/pdf">Decreto ministeriale 4 aprile 1985</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.gazzettaufficiale.it/eli/gu/1985/04/26/98/sg/pdf">gazzettaufficiale.it</a>.</p></gc-source-links>",
  "JP": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Japan"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Japan (checked October 14, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or less than 2.5 cm deep </th><td class="num">8&nbsp;µg/cm²</td><td class="num">0.7&nbsp;µg/cm²</td></tr><tr><th scope="row"> Other pieces under 1.1 L, not for cooking </th><td class="num">2&nbsp;µg/mL</td><td class="num">0.5&nbsp;µg/mL</td></tr><tr><th scope="row"> Other pieces from 1.1 L to under 3 L, not for cooking </th><td class="num">1&nbsp;µg/mL</td><td class="num">0.25&nbsp;µg/mL</td></tr><tr><th scope="row"> Other pieces of 3 L or more, not for cooking </th><td class="num">0.5&nbsp;µg/mL</td><td class="num">0.25&nbsp;µg/mL</td></tr><tr><th scope="row"> Cooking ware, 2.5 cm deep or more </th><td class="num">0.5&nbsp;µg/mL</td><td class="num">0.05&nbsp;µg/mL</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.caa.go.jp/policies/policy/standards_evaluation/appliance/assets/standards_cms101_250530_001.pdf">食品、添加物等の規格基準（昭和34年厚生省告示第370号）第3 D</a>.</gc-rich> A piece passes if it releases no more than the limit: the law says “at most”.  Cooking ware means pieces made mainly for cooking over a direct flame, in an oven or in a microwave. Pieces warmed in hot water or used at no more than 100 °C, such as sake warmers (tokkuri) and chawanmushi cups, are not cooking ware, nor are pieces only for reheating in a microwave. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.caa.go.jp/policies/policy/standards_evaluation/appliance/assets/standards_cms101_250530_001.pdf">caa.go.jp</a>.</p></gc-source-links>",
  "LT": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Lithuania"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Lithuania (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "LU": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Luxembourg"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Luxembourg (checked October 8, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">6&nbsp;µg/dm²</td><td class="num">4&nbsp;µg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">30&nbsp;µg/L</td><td class="num">20&nbsp;µg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">10&nbsp;µg/L</td><td class="num">7&nbsp;µg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://legilux.public.lu/eli/etat/leg/rgd/2026/05/19/a252/jo">Règlement grand-ducal du 19 mai 2026</a>.</gc-rich> In force from May 29, 2026. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://legilux.public.lu/eli/etat/leg/rgd/2026/05/19/a252/jo">legilux.public.lu</a>.</p></gc-source-links>",
  "LV": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Latvia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Latvia (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "MT": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Malta"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Malta (checked 08 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0.8&nbsp;mg/dm²</td><td class="num">0.07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0.3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1.5&nbsp;mg/L</td><td class="num">0.1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "NL": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Netherlands"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Netherlands (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">6&nbsp;µg/dm²</td><td class="num">4&nbsp;µg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">30&nbsp;µg/L</td><td class="num">20&nbsp;µg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">10&nbsp;µg/L</td><td class="num">7&nbsp;µg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://zoek.officielebekendmakingen.nl/stcrt-2026-16308.html">Warenwetregeling verpakkingen en gebruiksartikelen (Staatscourant 2026, 16308)</a>.</gc-rich> In force from 29 May 2026.  Pieces first sold before 1 December 2026 under the old rules may be sold until stocks run out. </p><gc-source-links><p class="region-sources"> Checked on: <a href="https://zoek.officielebekendmakingen.nl/stcrt-2026-16308.html">zoek.officielebekendmakingen.nl</a>.</p></gc-source-links>",
  "NZ": "<p>We have not yet confirmed the rules in New Zealand.</p>",
  "PL": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Poland"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Poland (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://api.sejm.gov.pl/eli/acts/DU/2008/113/text.pdf">Rozporządzenie Ministra Zdrowia z dnia 15 stycznia 2008 r. (Dz.U. 2008 nr 17 poz. 113)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://api.sejm.gov.pl/eli/acts/DU/2008/113/text.pdf">api.sejm.gov.pl</a>.</p></gc-source-links>",
  "PT": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Portugal"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Portugal (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "RO": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Romania"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Romania (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "SE": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Sweden"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Sweden (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.livsmedelsverket.se/4ad7ea/globalassets/om-oss/lagstiftning/forpackn---matrl-i-kontakt-m-livsm/livsfs-2023-5_kons_livsfs-2025-1.pdf">Livsmedelsverkets föreskrifter LIVSFS 2023:5, 5 kap.</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.livsmedelsverket.se/4ad7ea/globalassets/om-oss/lagstiftning/forpackn---matrl-i-kontakt-m-livsm/livsfs-2023-5_kons_livsfs-2025-1.pdf">livsmedelsverket.se</a>.</p></gc-source-links>",
  "SI": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Slovenia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Slovenia (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "SK": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in Slovakia"><table class="guide-table"><caption> What a fired piece may release in the legal test, in Slovakia (checked 8 October 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Pieces that cannot be filled, or no deeper than 25 mm </th><td class="num">0,8&nbsp;mg/dm²</td><td class="num">0,07&nbsp;mg/dm²</td></tr><tr><th scope="row"> Other pieces that can be filled </th><td class="num">4&nbsp;mg/L</td><td class="num">0,3&nbsp;mg/L</td></tr><tr><th scope="row"> Cooking ware of any size, and packaging and storage vessels over 3 L </th><td class="num">1,5&nbsp;mg/L</td><td class="num">0,1&nbsp;mg/L</td></tr></tbody></table></div><p> The EU's rules apply here. <gc-rich>Set by <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">Directive 84/500/EEC (amended by Directive 2005/31/EC)</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://publications.europa.eu/resource/celex/01984L0500-20050520">publications.europa.eu</a>.</p></gc-source-links>",
  "US": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Limits for ceramic ware in United States"><table class="guide-table"><caption> What a fired piece may release in the legal test, in United States (checked October 8, 2026) </caption><thead><tr><th scope="col">Kind of piece</th><th scope="col" class="num">Lead</th><th scope="col" class="num">Cadmium</th></tr></thead><tbody><tr><th scope="row"> Flatware, no deeper than 25 mm <span class="muted">(average of 6 pieces)</span></th><td class="num">3&nbsp;µg/mL</td><td class="num">0.5&nbsp;µg/mL</td></tr><tr><th scope="row"> Small hollowware, under 1.1 L, other than cups and mugs <span class="muted">(any one of 6)</span></th><td class="num">2&nbsp;µg/mL</td><td class="num">0.5&nbsp;µg/mL</td></tr><tr><th scope="row"> Cups and mugs <span class="muted">(any one of 6)</span></th><td class="num">0.5&nbsp;µg/mL</td><td class="num">0.5&nbsp;µg/mL</td></tr><tr><th scope="row"> Large hollowware, 1.1 L or more, other than pitchers <span class="muted">(any one of 6)</span></th><td class="num">1&nbsp;µg/mL</td><td class="num">0.25&nbsp;µg/mL</td></tr><tr><th scope="row"> Pitchers <span class="muted">(any one of 6)</span></th><td class="num">0.5&nbsp;µg/mL</td><td class="num">0.25&nbsp;µg/mL</td></tr></tbody></table></div><p><gc-rich>Set by <a href="https://www.fda.gov/media/71764/download">FDA Compliance Policy Guides 545.450 and 545.400</a>.</gc-rich></p><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.fda.gov/media/71764/download">fda.gov</a>.</p></gc-source-links>",
}
`;

exports[`region blocks before Turkey > says exactly what it said before for every earlier region: poison 1`] = `
{
  "AT": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Austria"><table class="guide-table"><caption> Who to call in Austria (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Vergiftungsinformationszentrale (VIZ) </th><td class="num"><a dir="ltr" class="phone" href="tel:+4314064343">01 406 43 43</a></td><td> 24 hours </td></tr><tr><th scope="row">Medical advice: Gesundheitsnummer 1450</th><td class="num"><a dir="ltr" class="phone" href="tel:1450">1450</a></td><td></td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://goeg.at/Vergiftungsinformation">goeg.at</a>, <a href="https://1450.at/">1450.at</a>.</p></gc-source-links></div>",
  "AU": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Australia"><table class="guide-table"><caption> Who to call in Australia (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:000">000</a></td><td></td></tr><tr><th scope="row"> Poison advice: Poisons Information Centre </th><td class="num"><a dir="ltr" class="phone" href="tel:131126">13 11 26</a></td><td> 24 hours, Australia-wide </td></tr><tr><th scope="row">Animals: Animal Poisons Helpline</th><td class="num"><a dir="ltr" class="phone" href="tel:1300869738">1300 869 738</a></td><td>24/7. From $75 AUD.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.healthdirect.gov.au/poisoning">healthdirect.gov.au</a>, <a href="https://animalpoisons.com.au/">animalpoisons.com.au</a>.</p></gc-source-links></div>",
  "BE": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Belgium"><table class="guide-table"><caption> Who to call in Belgium (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Antigifcentrum / Centre Antipoisons </th><td class="num"><a dir="ltr" class="phone" href="tel:+3270245245">070 245 245</a></td><td> 24/7, free. Pet questions weekdays 8:00 to 16:00, weekends 10:00 to 16:00. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.centreantipoisons.be/a-propos-de-nous/">centreantipoisons.be</a>.</p></gc-source-links></div>",
  "BG": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Bulgaria"><table class="guide-table"><caption> Who to call in Bulgaria (numbers checked October 8, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row">Poison advice</th><td class="num">-</td><td> We could not confirm a public poison line here. Call your doctor, or the emergency number if it is urgent. <gc-rich>The health ministry's page: <a href="https://www.mh.government.bg/">Министерство на здравеопазването</a>.</gc-rich></td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>.</p></gc-source-links></div>",
  "CY": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Cyprus"><table class="guide-table"><caption> Who to call in Cyprus (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row">Poison advice</th><td class="num">-</td><td> We could not confirm a public poison line here. Call your doctor, or the emergency number if it is urgent. <gc-rich>The health ministry's page: <a href="https://www.gov.cy/moh/">Υπουργείο Υγείας</a>.</gc-rich></td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>.</p></gc-source-links></div>",
  "CZ": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Czechia"><table class="guide-table"><caption> Who to call in Czechia (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Toxikologické informační středisko </th><td class="num"><a dir="ltr" class="phone" href="tel:+420224919293">224 91 92 93</a><br>or 224 91 54 02 </td><td> 24 hours. Also for animals. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://tis-cz.cz/index.php/informace-o-stredisku/kontakty">tis-cz.cz</a>.</p></gc-source-links></div>",
  "DE": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Germany"><table class="guide-table"><caption> Who to call in Germany (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Giftnotruf Berlin <span class="muted">(Berlin, Brandenburg)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+493019240">030 19240</a></td><td> 24 hours </td></tr><tr><th scope="row"> Poison advice: Giftnotruf Bonn <span class="muted">(Nordrhein-Westfalen)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+4922819240">0228 19240</a></td><td> 24 hours </td></tr><tr><th scope="row"> Poison advice: Giftnotruf Erfurt <span class="muted">(Mecklenburg-Vorpommern, Sachsen, Sachsen-Anhalt, Thüringen)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+49361730730">0361 730 730</a></td><td> 24 hours </td></tr><tr><th scope="row"> Poison advice: Giftnotruf Freiburg <span class="muted">(Baden-Württemberg)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+4976119240">0761 19240</a></td><td> 24 hours </td></tr><tr><th scope="row"> Poison advice: Giftnotruf Göttingen <span class="muted">(Bremen, Hamburg, Niedersachsen, Schleswig-Holstein)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+4955119240">0551 19240</a></td><td> 24 hours </td></tr><tr><th scope="row"> Poison advice: Giftnotruf Mainz <span class="muted">(Rheinland-Pfalz, Hessen, Saarland)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+49613119240">06131 19240</a></td><td> 24 hours </td></tr><tr><th scope="row"> Poison advice: Giftnotruf München <span class="muted">(Bayern)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+498919240">089 19240</a></td><td> 24 hours </td></tr><tr><th scope="row">Medical advice: Ärztlicher Bereitschaftsdienst 116117</th><td class="num"><a dir="ltr" class="phone" href="tel:116117">116117</a></td><td></td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.bvl.bund.de/DE/Arbeitsbereiche/01_Lebensmittel/03_Verbraucher/09_InfektionenIntoxikationen/02_Giftnotrufzentralen/lm_LMVergiftung_giftnotrufzentralen_node.html">bvl.bund.de</a>, <a href="https://www.116117.de/">116117.de</a>.</p></gc-source-links></div>",
  "DK": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Denmark"><table class="guide-table"><caption> Who to call in Denmark (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Giftlinjen </th><td class="num"><a dir="ltr" class="phone" href="tel:+4582121212">82 12 12 12</a></td><td> 24 hours </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.sundhed.dk/borger/patienthaandbogen/akutte-sygdomme/foerstehjaelp/forgiftninger/naar-dit-barn-har-spist-giftige-planter/">sundhed.dk</a>.</p></gc-source-links></div>",
  "EE": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Estonia"><table class="guide-table"><caption> Who to call in Estonia (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Mürgistusteabekeskus </th><td class="num"><a dir="ltr" class="phone" href="tel:16662">16662</a></td><td> 24/7, in Estonian, Russian and English. From abroad: +372 794 3794. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.16662.ee/">16662.ee</a>.</p></gc-source-links></div>",
  "ES": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Spain"><table class="guide-table"><caption> Who to call in Spain (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Servicio de Información Toxicológica </th><td class="num"><a dir="ltr" class="phone" href="tel:+34915620420">91 562 04 20</a></td><td> 24 hours, every day </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.mjusticia.gob.es/es/institucional/organismos/instituto-nacional/servicios/servicio-informacion/servicio-informacion1">mjusticia.gob.es</a>.</p></gc-source-links></div>",
  "FI": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Finland"><table class="guide-table"><caption> Who to call in Finland (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Myrkytystietokeskus </th><td class="num"><a dir="ltr" class="phone" href="tel:0800147111">0800 147 111</a><br>or 09 471 977 </td><td> 24 hours, free </td></tr><tr><th scope="row">Medical advice: Medical helpline 116117</th><td class="num"><a dir="ltr" class="phone" href="tel:116117">116117</a></td><td></td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.hus.fi/en/patient/hospitals-and-other-units/poison-information-center">hus.fi</a>, <a href="https://www.116117.fi/">116117.fi</a>.</p></gc-source-links></div>",
  "FR": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in France"><table class="guide-table"><caption> Who to call in France (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Paris <span class="muted">(Île-de-France and overseas)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+33140054848">01 40 05 48 48</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Angers <span class="muted">(Bretagne, Centre-Val de Loire, Normandie, Pays de la Loire)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+33241482121">02 41 48 21 21</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Bordeaux </th><td class="num"><a dir="ltr" class="phone" href="tel:+33556964080">05 56 96 40 80</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Lille <span class="muted">(Hauts-de-France)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:0800595959">08 00 59 59 59</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Lyon <span class="muted">(Auvergne-Rhône-Alpes)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+33472116911">04 72 11 69 11</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Marseille <span class="muted">(Provence-Alpes-Côte d'Azur, Corse)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+33491752525">04 91 75 25 25</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Nancy <span class="muted">(Grand Est, Bourgogne-Franche-Comté)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+33383225050">03 83 22 50 50</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centre antipoison, Toulouse <span class="muted">(Occitanie)</span></th><td class="num"><a dir="ltr" class="phone" href="tel:+33561777447">05 61 77 74 47</a></td><td> 24/7 </td></tr><tr><th scope="row">Animals: CNITV (Lyon)</th><td class="num"><a dir="ltr" class="phone" href="tel:+33478871040">04 78 87 10 40</a></td><td>08:30 to midnight</td></tr><tr><th scope="row">Animals: CAPAE-Ouest (Nantes)</th><td class="num"><a dir="ltr" class="phone" href="tel:+33240687740">02 40 68 77 40</a></td><td>08:30 to midnight. Free.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://centres-antipoison.net/">centres-antipoison.net</a>, <a href="https://www.cnitv.fr/Contact">cnitv.fr</a>.</p></gc-source-links></div>",
  "GB": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in United Kingdom"><table class="guide-table"><caption> Who to call in United Kingdom (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:999">999</a></td><td></td></tr><tr><th scope="row">Poison advice</th><td class="num">-</td><td> We could not confirm a public poison line here. Call your doctor, or the emergency number if it is urgent. </td></tr><tr><th scope="row">Medical advice: NHS 111</th><td class="num"><a dir="ltr" class="phone" href="tel:111">111</a></td><td>There is no public poisons line in the UK: NHS 111 (NHS 24 in Scotland) gives advice, and 999 is for an emergency.</td></tr><tr><th scope="row">Animals: Animal PoisonLine</th><td class="num"><a dir="ltr" class="phone" href="tel:+441202509000">01202 509 000</a></td><td>24 hours. £35 weekdays 8am to 8pm, £45 at other times.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.nhs.uk/conditions/poisoning/">nhs.uk</a>, <a href="https://www.animalpoisonline.co.uk/">animalpoisonline.co.uk</a>.</p></gc-source-links></div>",
  "GR": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Greece"><table class="guide-table"><caption> Who to call in Greece (numbers checked October 8, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Κέντρο Δηλητηριάσεων </th><td class="num"><a dir="ltr" class="phone" href="tel:+302107793777">210 779 3777</a></td><td>  </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.moh.gov.gr/articles/health/dieythynsh-dhmosias-ygieinhs/metadotika-kai-mh-metadotika-noshmata/c388-egkyklioi/12444-enhmerwsh-toy-koinoy-sxetika-me-dhlhthriash-apo-aithyloglykolh-parafloy">moh.gov.gr</a>.</p></gc-source-links></div>",
  "HR": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Croatia"><table class="guide-table"><caption> Who to call in Croatia (numbers checked October 8, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Centar za kontrolu otrovanja </th><td class="num"><a dir="ltr" class="phone" href="tel:+38512348342">01 2348 342</a></td><td> 24 hours </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.imi.hr/hr/centar-za-kontrolu-otrovanja/">imi.hr</a>.</p></gc-source-links></div>",
  "HU": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Hungary"><table class="guide-table"><caption> Who to call in Hungary (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Egészségügyi Toxikológiai Tájékoztató Szolgálat (ETTSZ) </th><td class="num"><a dir="ltr" class="phone" href="tel:+3680201199">06 80 20 11 99</a></td><td> Day and night, free </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://nngyk.gov.hu/hu/veszelyes-novenyek/mergezo-novenyek.html">nngyk.gov.hu</a>.</p></gc-source-links></div>",
  "IE": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Ireland"><table class="guide-table"><caption> Who to call in Ireland (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: National Poisons Information Centre </th><td class="num"><a dir="ltr" class="phone" href="tel:+35318092166">01 809 2166</a></td><td> 8am to 10pm only. Outside those hours, call your doctor, or 112 or 999 in an emergency. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.poisons.ie/">poisons.ie</a>.</p></gc-source-links></div>",
  "IT": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Italy"><table class="guide-table"><caption> Who to call in Italy (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Centro Antiveleni Milano Niguarda </th><td class="num"><a dir="ltr" class="phone" href="tel:+390266101029">02 6610 1029</a></td><td> 24/7. Also for animals. </td></tr><tr><th scope="row"> Poison advice: Centro Antiveleni Pavia </th><td class="num"><a dir="ltr" class="phone" href="tel:+39038224444">0382 24444</a></td><td> 24/7 </td></tr><tr><th scope="row"> Poison advice: Centro Antiveleni Bergamo </th><td class="num"><a dir="ltr" class="phone" href="tel:800883300">800 883300</a></td><td> 24 hours, free </td></tr><tr><th scope="row"> Poison advice: Centro Antiveleni Roma Gemelli </th><td class="num"><a dir="ltr" class="phone" href="tel:+39063054343">06 305 4343</a></td><td> 24/7. Also for animals. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.centroantiveleni.org/">centroantiveleni.org</a>, <a href="https://www.icsmaugeri.it/centro-antiveleni-cav-cnit">icsmaugeri.it</a>, <a href="https://www.asst-pg23.it/2021/04/centro-antiveleni-nuovo-traguardo-500mila-consulenze">asst-pg23.it</a>, <a href="https://www.policlinicogemelli.it/centri-specializzati/centro-antiveleni/">policlinicogemelli.it</a>.</p></gc-source-links></div>",
  "JP": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Japan"><table class="guide-table"><caption> Who to call in Japan (numbers checked October 12, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:119">119</a></td><td>Ambulance and fire.</td></tr><tr><th scope="row"> Poison advice: Japan Poison Information Center, Osaka (大阪中毒110番) </th><td class="num"><a dir="ltr" class="phone" href="tel:+81727272499">072-727-2499</a></td><td> 24 hours, every day, free. Only for acute poisoning that has actually happened, such as a swallowed glaze; not for long-term exposure, such as dust at work. </td></tr><tr><th scope="row"> Poison advice: Japan Poison Information Center, Tsukuba (つくば中毒110番) </th><td class="num"><a dir="ltr" class="phone" href="tel:+81298529999">029-852-9999</a></td><td> 24 hours, every day, free. Only for acute poisoning that has actually happened, such as a swallowed glaze; not for long-term exposure, such as dust at work. </td></tr><tr><th scope="row">Medical advice: Children's medical advice line (子ども医療電話相談)</th><td class="num"><a dir="ltr" class="phone" href="tel:%238000">#8000</a></td><td>Medical advice about a child, by phone. Hours vary by prefecture; in every prefecture it runs after midnight.</td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.fdma.go.jp/mission/enrichment/kyukyumusen_kinkyutuhou/119.html">fdma.go.jp</a>, <a href="https://www.j-poison-ic.jp/110serviece/service-guide-genelal/">j-poison-ic.jp</a>, <a href="https://www.mhlw.go.jp/topics/2006/10/tp1010-3.html">mhlw.go.jp</a>.</p></gc-source-links></div>",
  "LT": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Lithuania"><table class="guide-table"><caption> Who to call in Lithuania (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row">Poison advice</th><td class="num">-</td><td> We could not confirm a public poison line here. Call your doctor, or the emergency number if it is urgent. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>.</p></gc-source-links></div>",
  "LU": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Luxembourg"><table class="guide-table"><caption> Who to call in Luxembourg (numbers checked October 8, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Centre Antipoisons (Belgium) </th><td class="num"><a dir="ltr" class="phone" href="tel:80025500">8002 5500</a></td><td> 24 hours, free </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.centreantipoisons.be/">centreantipoisons.be</a>.</p></gc-source-links></div>",
  "LV": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Latvia"><table class="guide-table"><caption> Who to call in Latvia (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Saindēšanās un zāļu informācijas centrs </th><td class="num"><a dir="ltr" class="phone" href="tel:+37167042473">67042473</a></td><td> 24 hours </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://aslimnica.lv/stacionari/gailezers/intensivas-terapijas-klinika/saindesanas-un-zalu-informacijas-centrs/">aslimnica.lv</a>.</p></gc-source-links></div>",
  "MT": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Malta"><table class="guide-table"><caption> Who to call in Malta (numbers checked 08 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Malta National Poisons Centre </th><td class="num"><a dir="ltr" class="phone" href="tel:1774">1774</a></td><td> 08:00 to 20:00, every day. Outside those hours, go to a health centre or an emergency department. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://mnpc.gov.mt/en/faqs/general-faqs/">mnpc.gov.mt</a>.</p></gc-source-links></div>",
  "NL": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Netherlands"><table class="guide-table"><caption> Who to call in Netherlands (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row">Poison advice</th><td class="num">-</td><td> We could not confirm a public poison line here. Call your doctor, or the emergency number if it is urgent. <gc-rich>The health ministry's page: <a href="https://www.rijksoverheid.nl/ministeries/ministerie-van-volksgezondheid-welzijn-en-sport">Ministerie van Volksgezondheid, Welzijn en Sport</a>.</gc-rich></td></tr><tr><th scope="row">Medical advice: Your GP, or the out-of-hours GP post</th><td class="num"></td><td>There is no public poisons line in the Netherlands: the NVIC takes calls from professionals only.</td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://nvic.umcutrecht.nl/nvic/nl/">nvic.umcutrecht.nl</a>.</p></gc-source-links></div>",
  "NZ": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in New Zealand"><table class="guide-table"><caption> Who to call in New Zealand (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:111">111</a></td><td></td></tr><tr><th scope="row"> Poison advice: National Poisons Centre </th><td class="num"><a dir="ltr" class="phone" href="tel:0800764766">0800 764 766</a></td><td> 24/7, free </td></tr><tr><th scope="row">Animals: Animal Poisons Helpline</th><td class="num"><a dir="ltr" class="phone" href="tel:0800869738">0800 869 738</a></td><td>Or call your vet. Charges apply.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.newzealand.com/au/feature/new-zealand-emergency-information-and-contacts/">newzealand.com</a>, <a href="https://www.poisons.co.nz/">poisons.co.nz</a>, <a href="https://animalpoisons.com.au/">animalpoisons.com.au</a>.</p></gc-source-links></div>",
  "PL": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Poland"><table class="guide-table"><caption> Who to call in Poland (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Ośrodek Informacji Toksykologicznej, Kraków </th><td class="num"><a dir="ltr" class="phone" href="tel:+48124119999">12 411 99 99</a></td><td> 24 hours </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.su.krakow.pl/jednostki/oddzialy-kliniczne/oddzial-kliniczny-gastroenterologii-hepatologii-toksykologii-i-chorob-wewnetrznych">su.krakow.pl</a>.</p></gc-source-links></div>",
  "PT": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Portugal"><table class="guide-table"><caption> Who to call in Portugal (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: CIAV </th><td class="num"><a dir="ltr" class="phone" href="tel:800250250">800 250 250</a></td><td>  </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.sns24.gov.pt/pt/tema/intoxicacoes-e-envenenamentos/intoxicacoes/como-agir-em-caso-de-intoxicacao/">sns24.gov.pt</a>.</p></gc-source-links></div>",
  "RO": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Romania"><table class="guide-table"><caption> Who to call in Romania (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: TOXAPEL (children only) </th><td class="num"><a dir="ltr" class="phone" href="tel:+40212106282">021 210 62 82</a></td><td> Non-stop. For children only; no line for adults was found. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.spitaluldecopii.ro/">spitaluldecopii.ro</a>.</p></gc-source-links></div>",
  "SE": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Sweden"><table class="guide-table"><caption> Who to call in Sweden (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Giftinformationscentralen </th><td class="num"><a dir="ltr" class="phone" href="tel:+46104566700">010-456 6700</a></td><td> 24 hours. When it is acute, call 112 and ask for Giftinformation; this number is for less urgent questions. </td></tr><tr><th scope="row">Medical advice: 1177 Vårdguiden</th><td class="num"><a dir="ltr" class="phone" href="tel:1177">1177</a></td><td></td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://giftinformation.se/">giftinformation.se</a>, <a href="https://www.1177.se/">1177.se</a>.</p></gc-source-links></div>",
  "SI": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Slovenia"><table class="guide-table"><caption> Who to call in Slovenia (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row">Poison advice</th><td class="num">-</td><td> We could not confirm a public poison line here. Call your doctor, or the emergency number if it is urgent. <gc-rich>The health ministry's page: <a href="https://www.gov.si/drzavni-organi/ministrstva/ministrstvo-za-zdravje/">Ministrstvo za zdravje</a>.</gc-rich></td></tr><tr><th scope="row">Medical advice: Your own or duty doctor</th><td class="num"></td><td>There is no public poisons line in Slovenia: the centre takes calls from professionals only.</td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://ktf.si/prva-pomoc/">ktf.si</a>.</p></gc-source-links></div>",
  "SK": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in Slovakia"><table class="guide-table"><caption> Who to call in Slovakia (numbers checked 8 October 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:112">112</a></td><td>Free from any phone in the EU.</td></tr><tr><th scope="row"> Poison advice: Národné toxikologické informačné centrum </th><td class="num"><a dir="ltr" class="phone" href="tel:+421254774166">02/54 77 41 66</a><br>or +421 911 166 066 </td><td> 24/7. Also for animals. </td></tr><tr><th scope="row">Animals</th><td class="num">-</td><td>Call your vet.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://digital-strategy.ec.europa.eu/en/policies/112">digital-strategy.ec.europa.eu</a>, <a href="https://www.ntic.sk/">ntic.sk</a>.</p></gc-source-links></div>",
  "US": "<div class="poison-lines"><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Who to call in United States"><table class="guide-table"><caption> Who to call in United States (numbers checked October 8, 2026) </caption><thead><tr><th scope="col">For</th><th scope="col">Call</th><th scope="col">Hours and notes</th></tr></thead><tbody><tr><th scope="row">An emergency: unconscious, not breathing, a seizure</th><td class="num"><a dir="ltr" class="phone" href="tel:911">911</a></td><td></td></tr><tr><th scope="row"> Poison advice: Poison Help </th><td class="num"><a dir="ltr" class="phone" href="tel:+18002221222">1-800-222-1222</a></td><td> 24/7, free. Connects you to your regional poison center. <gc-rich>Online: <a href="https://www.poison.org/">webPOISONCONTROL</a>.</gc-rich></td></tr><tr><th scope="row">Animals: ASPCA Animal Poison Control</th><td class="num"><a dir="ltr" class="phone" href="tel:+18884264435">(888) 426-4435</a></td><td>24/7. A fee may apply.</td></tr><tr><th scope="row">Animals: Pet Poison Helpline</th><td class="num"><a dir="ltr" class="phone" href="tel:+18557647661">(855) 764-7661</a></td><td>24/7. $89 per incident.</td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://911info.wa.gov/uploads/1/5/3/3/153301440/international_visitor_messaging_for_translations_es-us.pdf">911info.wa.gov</a>, <a href="https://poisoncenters.org/">poisoncenters.org</a>, <a href="https://www.aspca.org/pet-care/animal-poison-control">aspca.org</a>, <a href="https://www.petpoisonhelpline.com/">petpoisonhelpline.com</a>.</p></gc-source-links></div>",
}
`;

exports[`region blocks before Turkey > says exactly what it said before for every earlier region: shops 1`] = `
{
  "AT": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Austria"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Austria (checked 8 October 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://shop.keramik.at/de/c/ola1-2/Rohstoffe.html">Keramik Lehrer</a><br><span translate="no" class="muted">Leonding</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay, ready-made glazes and kilns</td><td data-label="Packs seen">1 kg, 5 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Kali-Feldspat 13014; Natron-Feldspat 13015; Kaolin 13016; Quarzmehl W10 13020</span></td></tr><tr><th scope="row"><a translate="no" href="https://www.keramik-kraft.com/de/Rohstoffe--Spezialprodukte/Rohstoffe-Carbonate-Oxide/Rohstoffe-und-Oxide.html">KERAMIK-KRAFT Österreich</a><br><span translate="no" class="muted">Bad Vöslau</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay, ready-made glazes and kilns</td><td data-label="Packs seen">100 g, 1 kg, 10 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Feldspat Kali (D75) R360; Feldspat Natron (Maxum/LA75) R362; Kaolin WBH Cora R372</span></td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://shop.keramik.at/de/c/ola1-2/Rohstoffe.html">shop.keramik.at</a>, <a href="https://www.keramik-kraft.com/de/Rohstoffe--Spezialprodukte/Rohstoffe-Carbonate-Oxide/Rohstoffe-und-Oxide.html">keramik-kraft.com</a>.</p></gc-source-links>",
  "AU": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Australia"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Australia (checked 8 October 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://northcotepotterysupplies.com.au/collections/raw-materials-1">Northcote Pottery Supplies</a><br><span translate="no" class="muted">Brunswick East (Melbourne)</span></th><td data-label="Sells">raw glaze materials, oxides, clay and kilns</td><td data-label="Packs seen">1 kg, 5 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Feldspar - Potash 200; Kaolin - Eckalite 2; Silica 200#; Whiting - Omyacarb 10</span></td></tr><tr><th scope="row"><a translate="no" href="https://keaneceramics.com.au/collections/ceramics-powders">Keane Ceramics</a><br><span translate="no" class="muted">West Gosford, New South Wales</span></th><td data-label="Sells">raw glaze materials, frits and oxides</td><td data-label="Packs seen">1 kg, 5 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Feldspar Potash 200F; China Clay Eckalite; Silica 200#; Whiting Omya Carb 10</span></td></tr><tr><th scope="row"><a translate="no" href="https://www.potterysuppliesonline.com.au/product-category/raw-materials/">Pottery Supplies Online</a><br><span translate="no" class="muted">Milton (Brisbane)</span></th><td data-label="Sells">raw glaze materials, frits and oxides</td><td data-label="Packs seen">1 kg and 5 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Potash Feldspar; Kaolin – Eckalite; Silica 200; Calcite (Whiting) Omya Carb 10</span></td></tr><tr><th scope="row"><a translate="no" href="https://pugmill.com.au/product-category/raw-materials/">The Pug Mill</a><br><span translate="no" class="muted">Mile End (Adelaide)</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay and kilns</td><td data-label="Packs seen">2.5 kg, 5 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Feldspar Potash PM-FePo; Kaolin Eckalite 1 PM-KoEck1; Silica (200 Mesh) PM-Sili; Whiting – Omya Carb 10</span></td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://northcotepotterysupplies.com.au/collections/raw-materials-1">northcotepotterysupplies.com.au</a>, <a href="https://keaneceramics.com.au/collections/ceramics-powders">keaneceramics.com.au</a>, <a href="https://www.potterysuppliesonline.com.au/product-category/raw-materials/">potterysuppliesonline.com.au</a>, <a href="https://pugmill.com.au/product-category/raw-materials/">pugmill.com.au</a>.</p></gc-source-links>",
  "BE": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Belgium"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Belgium (checked 8 October 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://www.colpaertonline.be/nl/188-matieres-premieres">Colpaert</a><br><span translate="no" class="muted">Nevele, Wommelgem, Sint-Pieters-Leeuw</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay, ready-made glazes and kilns</td><td data-label="Packs seen">1 kg, 5 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Kaliveldspaat GR40B; Veldspaat-natron GR41; Kaolien GR20</span></td></tr><tr><th scope="row"><a translate="no" href="https://shop.keramiekcentrum.be/nl/grondstoffen/glazuurgrondstoffen/">Keramiek Centrum Limburg</a><br><span translate="no" class="muted">Genk</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay, ready-made glazes and kilns</td><td data-label="Packs seen">1 kg and 5 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Kaliumveldspaat GLZGR018; Natriumveldspaat; Kaolien</span></td></tr><tr><th scope="row"><a translate="no" href="https://auxcouleursdargile.be/76-matieres-premieres">Aux Couleurs d'Argiles</a><br><span translate="no" class="muted">Libramont-Recogne</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay and ready-made glazes</td><td data-label="Packs seen">1 kg and 5 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Feldspath potassique; Feldspath sodique; Kaolin</span></td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.colpaertonline.be/nl/188-matieres-premieres">colpaertonline.be</a>, <a href="https://shop.keramiekcentrum.be/nl/grondstoffen/glazuurgrondstoffen/">shop.keramiekcentrum.be</a>, <a href="https://auxcouleursdargile.be/76-matieres-premieres">auxcouleursdargile.be</a>.</p></gc-source-links>",
  "BG": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Bulgaria"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Bulgaria (checked October 8, 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://glazura.bg/product-category/other/">Глазура (Glazura)</a><br><span translate="no" class="muted">Троян</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay, and kilns</td><td data-label="Packs seen">100 g, 1 kg, and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Каолин на прах; Кварцово брашно &lt; 63 микрона</span><br> No feldspar seen. </td></tr><tr><th scope="row"><a translate="no" href="https://ceramit.eu/product-category/materiali_za_keramika/surovini/">Кератек (Ceramit)</a><br><span translate="no" class="muted">Брацигово, София</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay, and kilns</td><td data-label="Packs seen">100 g, 1 kg, and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Каолин К2; Кварцов пясък; Калциев карбонат</span><br> No feldspar seen. </td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://glazura.bg/product-category/other/">glazura.bg</a>, <a href="https://ceramit.eu/product-category/materiali_za_keramika/surovini/">ceramit.eu</a>.</p></gc-source-links>",
  "CY": "<p>We found no shop selling raw glaze materials in Cyprus.</p><div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Cyprus"><table class="guide-table shop-table"><caption> Shops elsewhere that say they deliver to Cyprus (checked 8 October 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://www.ramfos.gr/en/product-category/ceramic-materials/raw-materials/">Ράμφος Υλικοκεραμική (Ramfos)</a><br><span translate="no" class="muted">Λυκόβρυση, Αθήνα, Greece</span></th><td data-label="Sells">raw glaze materials, frits, oxides, clay and kilns</td><td data-label="Packs seen">100 g and 500 g</td><td data-label="Materials seen, by the shop's names"><span translate="no">Potassium Felspar; Sodium Felspar; Kaolin-China Clay; Quartz-Flint-Silica</span></td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.ramfos.gr/en/product-category/ceramic-materials/raw-materials/">ramfos.gr</a>, <a href="https://www.ramfos.gr/en/home/shipping/">ramfos.gr</a>.</p></gc-source-links>",
  "CZ": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Czechia"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Czechia (checked 8 October 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://www.keramickecentrum.cz/kategorie/42/suroviny">Keramické centrum</a><br><span translate="no" class="muted">Praha, Brno, Pečky</span></th><td data-label="Sells">raw glaze materials, oxides, ready-made glazes, clay and kilns</td><td data-label="Packs seen">100 g and 1 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Živec K 2/75 draselný (Orthoklas); Živec NA LF 90 sodný (Albit); Kaolin</span></td></tr><tr><th scope="row"><a translate="no" href="https://sluzbykeramikum.cz/suroviny-oxidy/">Služby keramikům</a><br><span translate="no" class="muted">Roudnice nad Labem</span></th><td data-label="Sells">raw glaze materials, oxides, ready-made glazes and kilns</td><td data-label="Packs seen">1 kg and 25 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">Živec 75 K13; Živec 55 NAK 60; Kaolín mletý; Křemen jemný ST6</span><br> Orders by form, without a cart. </td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.keramickecentrum.cz/kategorie/42/suroviny">keramickecentrum.cz</a>, <a href="https://sluzbykeramikum.cz/suroviny-oxidy/">sluzbykeramikum.cz</a>.</p></gc-source-links>",
