  "JP": "<div tabindex="0" role="region" class="guide-table-scroll" aria-label="Shops in Japan"><table class="guide-table shop-table"><caption> Some shops selling raw glaze materials in Japan (checked October 14, 2026) </caption><thead><tr><th scope="col">Shop</th><th scope="col">Sells</th><th scope="col">Packs seen</th><th scope="col">Materials seen, by the shop's names</th></tr></thead><tbody><tr><th scope="row"><a translate="no" href="https://www.tougei-dept.com/yuyaku-genryo">陶芸百貨店</a><br><span translate="no" class="muted">埼玉県上尾市</span></th><td data-label="Sells">raw glaze materials, oxides, clay, ready-made glazes, and kilns</td><td data-label="Packs seen"></td><td data-label="Materials seen, by the shop's names"><span translate="no">福島長石; 釜戸長石; 福島硅石; 天草陶石; 合成土灰</span></td></tr><tr><th scope="row"><a translate="no" href="http://02-maruni.sun.bindcloud.jp/cn8/yuuyakugenryou.html">丸二陶料</a></th><td data-label="Sells">raw glaze materials</td><td data-label="Packs seen">1 kg, 25 kg, and 30 kg</td><td data-label="Materials seen, by the shop's names"><span translate="no">三雲長石; 特級釜戸長石; 極上福島長石</span></td></tr><tr><th scope="row"><a translate="no" href="https://www.yamani-fc.jp/products/list.php?category_id=12">ヤマニファーストセラミック</a><br><span translate="no" class="muted">島根県松江市</span></th><td data-label="Sells">raw glaze materials and ready-made glazes</td><td data-label="Packs seen"></td><td data-label="Materials seen, by the shop's names"><span translate="no">特級福島長石; 特級釜戸長石; 三雲長石; 霞石閃長石(ネフェリン長石)</span></td></tr></tbody></table></div><gc-source-links><p class="region-sources"> Checked on: <a href="https://www.tougei-dept.com/yuyaku-genryo">tougei-dept.com</a>, <a href="http://02-maruni.sun.bindcloud.jp/cn8/yuuyakugenryou.html">02-maruni.sun.bindcloud.jp</a>, <a href="https://www.yamani-fc.jp/products/list.php?category_id=12">yamani-fc.jp</a>.</p></gc-source-links>",
