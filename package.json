{
  "name": "glazecalc",
  "version": "0.2.0",
  "description": "Glaze calculation software to assist potters and ceramicists.",
  "main": "index.js",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "node scripts/run.mjs dev",
    "prestart": "ng build",
    "start": "node --env-file-if-exists=.env server.js",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "test": "mocha",
    "test:client": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:client && npm run test:e2e",
    "test:coverage": "c8 --include \"server/**\" --include \"lib/**\" --exclude \"server/test/**\" --reporter text-summary --reporter html mocha",
    "test:client:coverage": "ng test --watch=false --coverage",
    "seed": "node --env-file-if-exists=.env scripts/seed-standard.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFilson/glazecalc.git"
  },
  "keywords": [
    "glaze",
    "glazes",
    "glazecalc",
    "potter",
    "potters",
    "ceramic",
    "ceramics",
    "firing",
    "utility",
    "clay",
    "kiln",
    "chart",
    "recipes"
  ],
  "author": "Aaron Filson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AaronFilson/glazecalc/issues"
  },
  "homepage": "https://github.com/AaronFilson/glazecalc#readme",
  "dependencies": {
    "bcrypt": "6.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.4",
    "nodemailer": "10.0.15"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "bootstrap": "5.3.8",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "chai-http": "5.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "^30.0.0",
    "mocha": "12.0.3",
    "prettier": "3.9.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "bcrypt": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
