{
  "name": "glazecalc",
  "version": "0.2.0",
  "description": "Glaze calculation software to assist potters and ceramicists.",
  "main": "index.js",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prestart": "ng build",
    "start": "node clientserver & node server",
    "test": "mocha server/test",
    "test:client": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:coverage": "c8 --include \"server/**\" --include \"lib/**\" --exclude \"server/test/**\" --reporter text-summary --reporter html mocha server/test --exit",
    "test:client:coverage": "ng test --watch=false --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFilson/glazecalc.git"
  },
  "keywords": [
    "glaze",
    "glazes",
    "glazecalc",
    "potter",
    "potters",
    "ceramic",
    "ceramics",
    "firing",
    "utility",
    "clay",
    "kiln",
    "chart",
    "recipes"
  ],
  "author": "Aaron Filson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AaronFilson/glazecalc/issues"
  },
  "homepage": "https://github.com/AaronFilson/glazecalc#readme",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "bcrypt": "6.0.0",
    "body-parser": "1.20.8",
    "bootstrap-sass": "^3.3.7",
    "express": "4.22.3",
    "html-loader": "4.2.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "7.8.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.3",
    "c8": "12.0.0",
    "chai": "4.5.0",
    "chai-http": "4.4.0",
    "jsdom": "^30.0.0",
    "mocha": "12.0.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
