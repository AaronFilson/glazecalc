{
  "name": "glazecalc",
  "version": "0.5.0",
  "description": "Glaze calculation software to assist potters and ceramicists.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "node scripts/advice-i18n.mjs && node scripts/material-i18n.mjs && node scripts/locale-fallback.mjs && ng build && node scripts/service-worker.mjs && node scripts/prerender.mjs && node scripts/build-skills.mjs",
    "watch": "node scripts/advice-i18n.mjs && node scripts/material-i18n.mjs && node scripts/locale-fallback.mjs && ng build --watch --configuration development",
    "dev": "node scripts/run.mjs dev",
    "db": "node --env-file-if-exists=.env scripts/db.mjs",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p server",
    "check:i18n": "node scripts/i18n-check.mjs",
    "i18n:sources": "node scripts/i18n-sources.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "test": "mocha",
    "test:mcp": "node scripts/mcp-conformance.mjs",
    "test:live": "node scripts/live-check.mjs && playwright test --config playwright.live.config.js",
    "test:forwarder": "mocha --no-config deploy/aws/mail-forwarder/test/*_tests.mjs",
    "test:client": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:linux": "node scripts/test-e2e-linux.mjs",
    "test:e2e:both": "node scripts/test-e2e-both.mjs",
    "test:all": "npm test && npm run test:client && npm run test:e2e",
    "test:all:linux": "npm test && npm run test:client && npm run test:e2e:linux",
    "test:coverage": "c8 --include \"server/**\" --include \"lib/**\" --exclude \"server/test/**\" --reporter text-summary --reporter html mocha",
    "test:client:coverage": "ng test --watch=false --coverage",
    "seed": "node --env-file-if-exists=.env scripts/seed-standard.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFilson/glazecalc.git"
  },
  "keywords": [
    "glaze",
    "glazes",
    "glazecalc",
    "potter",
    "potters",
    "ceramic",
    "ceramics",
    "firing",
    "utility",
    "clay",
    "kiln",
    "chart",
    "recipes"
  ],
  "author": "Aaron Filson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AaronFilson/glazecalc/issues"
  },
  "homepage": "https://github.com/AaronFilson/glazecalc#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@simplewebauthn/server": "14.0.3",
    "bcrypt": "6.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "intl-messageformat": "12.1.4",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "nodemailer": "10.2.0",
    "oidc-provider": "9.12.2",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@angular/ssr": "22.2.3",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@playwright/test": "1.64.1",
    "@simplewebauthn/browser": "14.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/chai": "5.2.3",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/oidc-provider": "9.12.1",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.6.0",
    "bootstrap": "5.3.8",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "chai-http": "5.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "^30.0.0",
    "marked": "18.1.1",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "rxjs": "~7.8.0",
    "sass-embedded": "1.106.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "bcrypt": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
